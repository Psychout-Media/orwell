.audit-telemetry/

# heavy-sim shard artifacts (local default *_RESULTS_DIR under tmp/ + CI's collected dirs)
tmp/
jury-results/
gradient-results/

# read-only surfacing-agent hypothesis scratch (never committed; excluded from vitest run below)
tests/scratch/

# throwaway repro/render scratch (delegate agents write repros + before/after renders here; never committed)
scratchpad/
frontend/scratchpad/

# Sealed-content exports must never be committed (mandate #2 — the Vault Wall). The producerVault
# DEBUG unseal and the "unsealed" debug-bundle flavor both carry hidden-layer content; keep them local.
orwell-producers-vault*.json
orwell-debug-bundle-unsealed*.json

# a .venv SYMLINK (worktree convenience) is not matched by the `.venv/` dir pattern — never commit it
/frontend/.venv
/node_modules
/frontend/data.*/
/data.*/

# ORW-39: vitest blob reports from sharded coverage runs (CI-only artifacts, never committed)
.vitest-reports/
__pycache__/
